<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "EventFlow - Event Booking System" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="EventFlow">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="description" content="EventFlow - A modern event booking system for discovering and managing events">
    <meta name="theme-color" content="#0066FF">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%# Favicon - EventFlow Logo %>
    <link rel="icon" href="<%= asset_path('favicon.png') %>" type="image/png">
    <link rel="apple-touch-icon" href="<%= asset_path('favicon.png') %>">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-..." crossorigin="anonymous">
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <%= render "layouts/navbar" %>
    <%= render 'shared/flashes' %>
    <%= yield %>
  </body>
</html>
